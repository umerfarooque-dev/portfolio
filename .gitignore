# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# prisma local db (use DATABASE_URL in production)
prisma/*.db
prisma/*.db-journal

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated Prisma clients — stale, regenerated into node_modules/.prisma instead.
# ~150 MB incl. query-engine binaries; must never be committed.
/src/generated

# agent + scratch working dirs
/.claude
/scratch

# leftover local uploads from the removed admin CMS
/public/uploads
