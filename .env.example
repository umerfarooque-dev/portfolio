# ---------------------------------------------------------------------------
# Contact form (required for "Send message" to work)
# ---------------------------------------------------------------------------
# Get a key from https://resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Must be a domain verified in Resend; defaults to Resend's sandbox
# sender, which can only deliver to the Resend account's own address.
# RESEND_FROM_EMAIL=Portfolio <noreply@yourdomain.com>

# Optional. Where submissions are delivered. Defaults to SITE.email.
# CONTACT_TO_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# Database (Prisma) — OPTIONAL
# ---------------------------------------------------------------------------
# Not required to build or deploy. The site's content lives in src/data/*.ts;
# Prisma is only an override for the siteContent row and the legacy /projects
# listing, and src/lib/site-data.ts degrades every read to the static data when
# there is no reachable database. Leave this unset on Vercel.
#
# SQLite is fine locally. Do NOT point this at a file on Vercel — the filesystem
# there is ephemeral. If you want a real database in production, use hosted
# Postgres and switch `provider` in prisma/schema.prisma to match.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute base URL, used for canonical links and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://umer-porfolio.vercel.app
